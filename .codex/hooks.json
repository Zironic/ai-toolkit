{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-hooks/agent_hooks.py\" pre-bash",
            "commandWindows": "$root = (git rev-parse --show-toplevel).Trim(); & \"$root\\venv\\Scripts\\python.exe\" \"$root\\.agent-hooks\\agent_hooks.py\" pre-bash",
            "timeout": 10,
            "statusMessage": "Checking shell command policy"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-hooks/agent_hooks.py\" pre-edit",
            "commandWindows": "$root = (git rev-parse --show-toplevel).Trim(); & \"$root\\venv\\Scripts\\python.exe\" \"$root\\.agent-hooks\\agent_hooks.py\" pre-edit",
            "timeout": 10,
            "statusMessage": "ASCII-fying edit payload"
          }
        ]
      },
      {
        "matcher": "^(Read|mcp__.*__(read|get|open).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-hooks/agent_hooks.py\" pre-read",
            "commandWindows": "$root = (git rev-parse --show-toplevel).Trim(); & \"$root\\venv\\Scripts\\python.exe\" \"$root\\.agent-hooks\\agent_hooks.py\" pre-read",
            "timeout": 10,
            "statusMessage": "Checking file-read size"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-hooks/agent_hooks.py\" format-after-edit",
            "commandWindows": "$root = (git rev-parse --show-toplevel).Trim(); & \"$root\\venv\\Scripts\\python.exe\" \"$root\\.agent-hooks\\agent_hooks.py\" format-after-edit",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
