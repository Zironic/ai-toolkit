#!/usr/bin/env bash
set -euo pipefail

IMAGE_REPO="${IMAGE_REPO:-ghcr.io/zironic/ai-toolkit}"
SOURCE_REPO="${SOURCE_REPO:-https://github.com/Zironic/ai-toolkit.git}"
SOURCE_REF="${SOURCE_REF:-$(git rev-parse HEAD)}"
SOURCE_CREATED="${SOURCE_CREATED:-$(git show -s --format=%aI "${SOURCE_REF}")}"
ALIAS_TAG="${ALIAS_TAG:-}"
SHORT_SHA="${SOURCE_REF:0:12}"
IMMUTABLE_TAG="${IMAGE_REPO}:sha-${SHORT_SHA}"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Refusing to publish from a dirty worktree."
    exit 1
fi

build_args=(
    --file docker/Dockerfile
    --build-arg "SOURCE_REPO=${SOURCE_REPO}"
    --build-arg "SOURCE_REF=${SOURCE_REF}"
    --build-arg "SOURCE_CREATED=${SOURCE_CREATED}"
    --tag "${IMMUTABLE_TAG}"
)

if [[ -n "${ALIAS_TAG}" ]]; then
    build_args+=(--tag "${IMAGE_REPO}:${ALIAS_TAG}")
fi

docker build "${build_args[@]}" .
docker push "${IMMUTABLE_TAG}"

if [[ -n "${ALIAS_TAG}" ]]; then
    docker push "${IMAGE_REPO}:${ALIAS_TAG}"
fi

echo "Published ${IMMUTABLE_TAG}"
